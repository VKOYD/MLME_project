#NARX-style model with two quantiles
class NARX_Quantiles(nn.Module):
    def __init__(self, input_dim, output_dim):
        super(NARX_Quantiles, self).__init__()
        self.net = nn.Sequential(
            nn.Linear(input_dim, 128),
            nn.ReLU(),
            nn.Linear(128, 64),
            nn.ReLU(),
            nn.Linear(64, 2*output_dim) #2 quantiles
        )

    def forward(self, x):
        return self.net(x)

#PinballLoss fuction
class PinballLoss(nn.Module):
    def __init__(self, taus,n_outputs):
        super().__init__()
        self.taus = taus  # list of quantiles, e.g., [0.05, 0.95]
        self.n_outputs = n_outputs
        
    def forward(self, y_pred, y_true):
        total_loss = 0
        for j in range(self.n_outputs):
            for i, tau in enumerate(self.taus):
                pred_q = y_pred[:, j + i * self.n_outputs]  # lower or upper quantile
                true_err = y_true[:, j]

                diff = true_err - pred_q
                loss = torch.where(diff >= 0,
                                   tau * diff,
                                   (1 - tau) * (-diff))
                total_loss += torch.mean(loss)

        total_loss /= (len(self.taus) * self.n_outputs)
        return total_loss


